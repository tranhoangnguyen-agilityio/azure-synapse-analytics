{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "location": {
            "type": "String",
            "defaultValue": "eastus"
        },
        "azureKeyVaultResourceGroup": {
            "type": "String",
            "defaultValue": "local-deployment"
        },
        "containerIdentityRoleAssignmentId2": {
            "type": "String",
            "defaultValue": "[newGuid()]"
        },
        "azureKeyVault": {
            "type": "string",
            "defaultValue": "tenant-github-deploykey"
        },
        "containerIdentityName": {
            "type": "string",
            "defaultValue": "containerIdentityTest"
        }
    },
    "variables": {
        "Owner": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Authorization/roleDefinitions/', '8e3af657-a8ff-443c-a75c-2fe8c4bcb635')]",
        "Contributor": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Authorization/roleDefinitions/', 'b24988ac-6180-42a0-ab88-20f7382dd24c')]",
        "Reader": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Authorization/roleDefinitions/', 'acdd72a7-3385-48ef-bd42-f606fba81ae7')]",
        "KeyVaultSecretsUser": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Authorization/roleDefinitions/', '4633458b-17de-408a-b874-0445c86b69e6')]"
    },
    "resources": [
        {
            "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
            "apiVersion": "2023-07-31-preview",
            "name": "[parameters('containerIdentityName')]",
            "location": "[parameters('location')]"
        },
        {
            "type": "Microsoft.Authorization/roleAssignments",
            "apiVersion": "2022-04-01",
            "name": "[parameters('containerIdentityRoleAssignmentId2')]",
            "scope": "/subscriptions/efdd28a3-55e6-4711-a58b-ab398c259094/resourceGroups/r-Collectiv/providers/Microsoft.KeyVault/vaults/r-collectiv-app",
            "properties": {
                "roleDefinitionId": "[variables('KeyVaultSecretsUser')]",
                "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('containerIdentityName')), '2023-01-31', 'Full').properties.principalId]",
                "principalType": "ServicePrincipal"
            },
            "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('containerIdentityName'))]"
            ]
        }
    ]
}
